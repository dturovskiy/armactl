#!/usr/bin/env python3
"""Render a stable release badge without querying third-party badge APIs."""

from __future__ import annotations

import argparse
import html
from pathlib import Path


LABEL_COLOR = "#555"
RELEASE_COLOR = "#ea7233"
FONT_FAMILY = "Verdana,Geneva,DejaVu Sans,sans-serif"


def _text_width(text: str, *, label: bool = False) -> int:
    padding = 7 if label else 9
    return len(text) * 6 + padding


def render_badge(version: str) -> str:
    label = "release"
    value = version if version.startswith("v") else f"v{version}"
    label_width = _text_width(label, label=True)
    value_width = _text_width(value)
    total_width = label_width + value_width
    label_x = label_width / 2 + 1
    value_x = label_width + value_width / 2 - 1
    safe_label = html.escape(label)
    safe_value = html.escape(value)
    label_text_length = (label_width - 10) * 10
    value_text_length = (value_width - 10) * 10

    return f"""<svg xmlns="http://www.w3.org/2000/svg" width="{total_width}" height="20"
  role="img" aria-label="{safe_label}: {safe_value}">
  <title>{safe_label}: {safe_value}</title>
  <filter id="blur"><feGaussianBlur stdDeviation="16"/></filter>
  <linearGradient id="s" x2="0" y2="100%">
    <stop offset="0" stop-color="#bbb" stop-opacity=".1"/>
    <stop offset="1" stop-opacity=".1"/>
  </linearGradient>
  <clipPath id="r">
    <rect width="{total_width}" height="20" rx="3"/>
  </clipPath>
  <g clip-path="url(#r)">
    <rect width="{label_width}" height="20" fill="{LABEL_COLOR}"/>
    <rect x="{label_width}" width="{value_width}" height="20" fill="{RELEASE_COLOR}"/>
    <rect width="{total_width}" height="20" fill="url(#s)"/>
  </g>
  <g fill="#fff" text-anchor="middle" font-family="{FONT_FAMILY}"
    text-rendering="geometricPrecision" font-size="110">
    <g transform="scale(.1)">
      <g aria-hidden="true" fill="#010101">
        <text x="{label_x * 10}" y="150" fill-opacity=".8"
          filter="url(#blur)" textLength="{label_text_length}">{safe_label}</text>
        <text x="{label_x * 10}" y="150" fill-opacity=".3"
          textLength="{label_text_length}">{safe_label}</text>
      </g>
      <text x="{label_x * 10}" y="140" textLength="{label_text_length}">{safe_label}</text>
    </g>
    <g transform="scale(.1)">
      <g aria-hidden="true" fill="#010101">
        <text x="{value_x * 10}" y="150" fill-opacity=".8"
          filter="url(#blur)" textLength="{value_text_length}">{safe_value}</text>
        <text x="{value_x * 10}" y="150" fill-opacity=".3"
          textLength="{value_text_length}">{safe_value}</text>
      </g>
      <text x="{value_x * 10}" y="140" textLength="{value_text_length}">{safe_value}</text>
    </g>
  </g>
</svg>
"""


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("version")
    parser.add_argument("output", type=Path)
    args = parser.parse_args()

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(render_badge(args.version), encoding="utf-8")


if __name__ == "__main__":
    main()
