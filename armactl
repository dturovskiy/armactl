#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
VENV_PY="$SCRIPT_DIR/.venv/bin/python"
BOOTSTRAP_SCRIPT="$SCRIPT_DIR/scripts/bootstrap.sh"
BOOTSTRAP_MODE="${ARMACTL_BOOTSTRAP_MODE:---prod}"
STAMP_FILE="$SCRIPT_DIR/.venv/.armactl-pyproject.sha256"
ARMACTL_PYTHON="${ARMACTL_PYTHON:-}"

pyproject_hash() {
    sha256sum "$SCRIPT_DIR/pyproject.toml" | awk '{print $1}'
}

mode_satisfies() {
    installed_mode="${1:-}"
    requested_mode="${2:-}"

    case "$requested_mode" in
        ""|--prod)
            return 0
            ;;
        --web)
            [ "$installed_mode" = "--web" ] || [ "$installed_mode" = "--dev" ]
            return
            ;;
        --dev)
            [ "$installed_mode" = "--dev" ]
            return
            ;;
        *)
            return 1
            ;;
    esac
}

venv_needs_refresh() {
    if [ ! -f "$STAMP_FILE" ]; then
        return 0
    fi

    read -r stamped_hash stamped_mode < "$STAMP_FILE" || return 0

    [ "$stamped_hash" != "$(pyproject_hash)" ] && return 0
    mode_satisfies "$stamped_mode" "$BOOTSTRAP_MODE" || return 0

    return 1
}

venv_python_healthy() {
    "$VENV_PY" -c "import encodings, armactl" >/dev/null 2>&1
}

if [ -n "$ARMACTL_PYTHON" ]; then
    exec "$ARMACTL_PYTHON" -m armactl "$@"
fi

if [ ! -x "$VENV_PY" ]; then
    echo "armactl first-run setup: preparing local environment..." >&2
    if [ ! -x "$BOOTSTRAP_SCRIPT" ]; then
        echo "Missing bootstrap script: $BOOTSTRAP_SCRIPT" >&2
        exit 1
    fi
    "$BOOTSTRAP_SCRIPT" "$BOOTSTRAP_MODE"
elif venv_needs_refresh; then
    echo "armactl dependency sync: refreshing local environment..." >&2
    "$BOOTSTRAP_SCRIPT" "$BOOTSTRAP_MODE"
elif ! venv_python_healthy; then
    echo "armactl dependency sync: local environment is not runnable; refreshing..." >&2
    "$BOOTSTRAP_SCRIPT" "$BOOTSTRAP_MODE"
fi

exec "$VENV_PY" -m armactl "$@"
