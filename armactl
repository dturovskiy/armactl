#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
VENV_PY="$SCRIPT_DIR/.venv/bin/python"
BOOTSTRAP_SCRIPT="$SCRIPT_DIR/scripts/bootstrap.sh"
if [ -n "${ARMACTL_BOOTSTRAP_MODE:-}" ]; then
    BOOTSTRAP_MODE="$ARMACTL_BOOTSTRAP_MODE"
elif [ "${1:-}" = "web" ]; then
    BOOTSTRAP_MODE="--web"
else
    BOOTSTRAP_MODE="--prod"
fi
STAMP_FILE="$SCRIPT_DIR/.venv/.armactl-pyproject.sha256"
ARMACTL_PYTHON="${ARMACTL_PYTHON:-}"

pyproject_hash() {
    sha256sum "$SCRIPT_DIR/pyproject.toml" | awk '{print $1}'
}

mode_satisfies() {
    installed_mode="${1:-}"
    requested_mode="${2:-}"

    case "$requested_mode" in
        ""|--prod)
            return 0
            ;;
        --web)
            [ "$installed_mode" = "--web" ] || [ "$installed_mode" = "--dev" ]
            return
            ;;
        --dev)
            [ "$installed_mode" = "--dev" ]
            return
            ;;
        *)
            return 1
            ;;
    esac
}

venv_needs_refresh() {
    if [ ! -f "$STAMP_FILE" ]; then
        return 0
    fi

    read -r stamped_hash stamped_mode < "$STAMP_FILE" || return 0

    [ "$stamped_hash" != "$(pyproject_hash)" ] && return 0
    mode_satisfies "$stamped_mode" "$BOOTSTRAP_MODE" || return 0

    return 1
}

venv_python_healthy() {
    "$VENV_PY" -c "import encodings, armactl" >/dev/null 2>&1
}

print_noninteractive_recovery() {
    echo "armactl dependency setup needs an interactive TTY." >&2
    echo "Requested bootstrap mode: $BOOTSTRAP_MODE" >&2
    echo "Diagnose without changing files:" >&2
    echo "  ./scripts/bootstrap.sh --check $BOOTSTRAP_MODE" >&2
    echo "Recover from an interactive shell:" >&2
    echo "  ./scripts/bootstrap.sh $BOOTSTRAP_MODE" >&2
    echo "Do not hand-edit $STAMP_FILE." >&2
    echo "Temporary smoke workaround only when .venv is known-good:" >&2
    echo "  ARMACTL_PYTHON=.venv/bin/python ./armactl ..." >&2
}

run_bootstrap() {
    message="$1"
    echo "$message" >&2
    if [ ! -x "$BOOTSTRAP_SCRIPT" ]; then
        echo "Missing bootstrap script: $BOOTSTRAP_SCRIPT" >&2
        exit 1
    fi
    if [ ! -t 0 ]; then
        print_noninteractive_recovery
        exit 1
    fi
    "$BOOTSTRAP_SCRIPT" "$BOOTSTRAP_MODE"
}

if [ -n "$ARMACTL_PYTHON" ]; then
    exec "$ARMACTL_PYTHON" -m armactl "$@"
fi

if [ ! -x "$VENV_PY" ]; then
    run_bootstrap "armactl first-run setup: preparing local environment..."
elif venv_needs_refresh; then
    run_bootstrap "armactl dependency sync: refreshing local environment..."
elif ! venv_python_healthy; then
    run_bootstrap "armactl dependency sync: local environment is not runnable; refreshing..."
fi

exec "$VENV_PY" -m armactl "$@"
