[Unit]
Description=armactl Web Panel
After=network-online.target
Wants=network-online.target
RequiresMountsFor={{ project_root }} {{ data_root }} {{ runtime_dir }}
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ user }}
WorkingDirectory={{ project_root }}
ExecStart={{ python_bin }} -m armactl web run --data-root {{ data_root }}
Restart=always
RestartSec=15
Environment=HOME={{ home_dir }}
Environment=USER={{ user }}
Environment=PYTHONUNBUFFERED=1
Environment=ARMACTL_WEB_DATA_ROOT={{ data_root }}

[Install]
WantedBy=multi-user.target
